# AIDAH Environment Variables Template
NEXT_PUBLIC_APP_NAME="AIDAH"
NEXT_PUBLIC_APP_TAGLINE="Handcrafted Designer Wear"
NEXT_PUBLIC_STORE_CURRENCY="INR"
NEXT_PUBLIC_STORE_CURRENCY_SYMBOL="₹"

# Security & Authentication
JWT_SECRET="replace-with-a-64-character-cryptographic-secret"

# Database Configuration (LibSQL / SQLite)
# For local development:
DATABASE_URL="file:./data/aidah.db"
# For Turso Cloud deployment (optional):
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Default Initial Administrator Setup
ADMIN_DEFAULT_EMAIL="admin@aidah.com"
ADMIN_DEFAULT_PASSWORD="Admin@Aidah2026"

# Payment Gateway Sandbox Keys
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
